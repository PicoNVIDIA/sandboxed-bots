#
# NeMo Relay observability config for ONE Hermes agent sandbox.
#
# Install to /sandbox/.hermes/relay-plugins.toml, then point Hermes at it:
#   echo 'HERMES_NEMO_RELAY_PLUGINS_TOML=/sandbox/.hermes/relay-plugins.toml' \
#     >> /sandbox/.hermes/.env
#
# A GATEWAY RESTART IS MANDATORY. The variable is read once at process start by
# _ProcessRelayPluginConfiguration.acquire(); a module-level singleton
# short-circuits every later call. Setting it mid-flight does nothing.
#
# FAILS OPEN: a missing or malformed file logs a warning and continues with Relay
# plugins OFF — a healthy agent that silently exports nothing. Always verify with
# the collector's exporter counters, never by assuming.

version = 1

[[components]]
kind = "observability"
enabled = true

[components.config]
version = 3

[components.config.opentelemetry]
enabled = true

# Projection choice per endpoint:
#   gen_ai        -> OTel GenAI semantic conventions; what LangSmith renders runs from
#   openinference -> OpenInference spans; native for Arize Phoenix
#   full          -> everything incl. nemo_relay.* attributes; best for debugging
#
# Relay derives trace/span IDs deterministically from lifecycle UUIDs, so two
# endpoints of DIFFERENT types must not share the same endpoint+transport — that
# is rejected to prevent identifier collisions at the receiver.
[[components.config.opentelemetry.endpoints]]
type = "gen_ai"
# host.openshell.internal is the OpenShell bridge. It resolves ONLY inside a
# sandbox — a host-side probe of this name always fails.
endpoint = "http://host.openshell.internal:4319/v1/traces"
transport = "http_binary"
service_name = "hermes-AGENT_NAME"        # replace per agent
service_namespace = "hermes-swarm"
timeout_millis = 8000

[components.config.opentelemetry.endpoints.resource_attributes]
"agent.name" = "AGENT_NAME"               # replace per agent; makes traces filterable
"deployment.environment" = "your-cluster"
