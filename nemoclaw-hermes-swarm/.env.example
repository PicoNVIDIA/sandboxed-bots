#
# Copy to .env and edit. NEVER commit .env — it is gitignored for a reason.
#
#   cp .env.example .env && $EDITOR .env

# ── Inference endpoint (required) ────────────────────────────────────────────
# Any OpenAI-compatible /v1 endpoint: vLLM, SGLang, NIM, or a hosted API.
#
# IMPORTANT: sandboxes have their OWN network namespace, so 127.0.0.1 inside a
# sandbox is the sandbox itself. Use an address reachable from inside one:
#   - host.openshell.internal:<port>   (the OpenShell bridge — preferred)
#   - a routable LAN address or public URL
# If your server binds only to 127.0.0.1 on the host, run the relay from
# Dockerfile.relay to republish it on the bridge. See README.
INFERENCE_URL=http://host.openshell.internal:18001/v1

# The model name your endpoint reports at /v1/models.
INFERENCE_MODEL=my-model

# Leave as-is for a local endpoint with no auth. For a hosted API, put the real
# key here. It is written into each sandbox's config at spawn time and never
# committed.
INFERENCE_KEY=local-noauth

# ── Sizing (optional) ───────────────────────────────────────────────────────
# Hermes otherwise requests the entire context window as OUTPUT tokens, which
# many local servers reject with a 400. Keep max_tokens well under the window.
AGENT_MAX_TOKENS=8192
AGENT_CONTEXT_LENGTH=65536

# ── Sandbox resources (optional) ────────────────────────────────────────────
SANDBOX_MEMORY=8Gi
SANDBOX_CPU=4

# ── Ports (optional) ────────────────────────────────────────────────────────
# Each agent gets one api_server port, allocated upward from this base. Change
# only if it collides with something on your host.
API_PORT_BASE=8477

# ── Optional integrations ───────────────────────────────────────────────────
# Uncomment to enable. Each also needs the matching policy in policies/ applied
# to the agent's sandbox — an env var alone grants nothing, because egress is
# deny-by-default.

# Public web search (search-only; page extraction stays blocked)
# TAVILY_API_KEY=

# Read-only GitHub REST. Use a fine-grained token with the minimum scope.
# A short-lived OAuth token (gho_...) will expire and break the agent silently;
# prefer a real PAT.
# GITHUB_TOKEN=
# GITHUB_READONLY_REPOS=owner/repo1,owner/repo2
