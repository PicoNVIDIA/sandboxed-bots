FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
# Python 3.11 from deadsnakes so the Hermes installer never has to fetch a
# standalone build through the sandbox egress proxy (redirects get 403d).
RUN apt-get update && apt-get install -y --no-install-recommends \
      software-properties-common ca-certificates curl gnupg \
 && add-apt-repository -y ppa:deadsnakes/ppa \
 && apt-get update && apt-get install -y --no-install-recommends \
      python3.11 python3.11-venv python3.11-dev \
      python3 python3-venv python3-pip git jq iproute2 sudo xz-utils libatomic1 build-essential \
 && rm -rf /var/lib/apt/lists/*
RUN groupadd -g 2000 sandbox && \
    useradd -u 2000 -g 2000 -m -s /bin/bash sandbox && \
    mkdir -p /sandbox && chown -R sandbox:sandbox /sandbox
ENV HERMES_HOME=/sandbox/.hermes
ENV HOME=/sandbox
WORKDIR /sandbox
CMD ["sleep", "infinity"]
